# App
DATABASE_URL="postgresql://devotly:devotly@localhost:5432/devotly"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CUSTOMER_LINK_SECRET="replace-with-long-random-secret"
CRON_SECRET="replace-with-long-random-cron-secret"
SESSION_SECRET="replace-with-long-random-session-secret"
BILLING_CURRENCY="cad"
# When true, allows live sending without an active Stripe subscription (dev/demo only)
ALLOW_TRIAL_WITHOUT_STRIPE="false"

# Twilio SMS (optional — dry-run when missing)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM_NUMBER=""

# SendGrid email (optional — dry-run when missing)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME="Devotly Coupon Book"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_COUPON_BOOK_MONTHLY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Apple Wallet (optional — buttons hidden when missing)
APPLE_WALLET_PASS_TYPE_ID=""
APPLE_WALLET_TEAM_ID=""
APPLE_WALLET_CERT_PEM=""
APPLE_WALLET_KEY_PEM=""
APPLE_WALLET_KEY_PASSPHRASE=""

# Google Wallet (optional — buttons hidden when missing)
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=""
